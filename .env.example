# Settings for the Ethereal Spaces website.
# On the VPS: copy this file to .env next to docker-compose.yml and fill it in.
# On Vercel: add the email settings under Project → Settings → Environment Variables.
# Never commit the real .env file (it is git-ignored).

# ---- Server (Docker) ----
# Port on the server where the site is reachable: http://SERVER-IP:HOST_PORT
HOST_PORT=3005

# Public address of the site, used for SEO links, the sitemap and social previews.
# Use http://YOUR-SERVER-IP:3005 for now and your domain later. Rebuild after changing it.
NEXT_PUBLIC_SITE_URL=http://YOUR-SERVER-IP:3005

# ---- Email delivery for website enquiries (Contact form and callback popup) ----
# Without these, the form asks visitors to send their enquiry on WhatsApp instead.

# Gmail account that sends the enquiry emails
SMTP_USER=spaces.ethereal@gmail.com

# 16-character Gmail App Password (NOT your normal Gmail password).
# Create one at https://myaccount.google.com/apppasswords (2-Step Verification must be on).
SMTP_PASS=

# Optional: where enquiries are delivered, comma-separated. Defaults to spaces.ethereal@gmail.com
CONTACT_RECIPIENT_EMAILS=

# Optional: only needed if you switch away from Gmail
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
